# direnv: このディレクトリに入ったときだけ有効になる環境変数。
# 値は .env に書く(.env は gitignore 済み。.env.example をコピーして作成)。

# 親シェルの AWS_PROFILE を引き継がず、サンプルごとに明示したプロファイルだけを使う
unset AWS_PROFILE AWS_DEFAULT_PROFILE

watch_file .env
dotenv_if_exists .env

if [ -z "${AWS_PROFILE:-}" ]; then
  log_error "AWS_PROFILE が未設定です。.env.example を .env にコピーして設定してください"
fi
