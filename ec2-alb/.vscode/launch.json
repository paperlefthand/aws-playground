{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI (uvicorn --reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/app/src",
      "python": "${workspaceFolder}/app/.venv/bin/python",
      "justMyCode": true
    }
  ]
}
